#version 450
// x = (x + w ⊙ t / sqrt(mean(t²) + eps)) · scale, one workgroup per token:
// Gemma 4's post-attention and post-FFN norms before the residual add, and
// its per-layer block's post-norm, add and layer scale (scale 1 for the
// first two).
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer T { float t[]; };
layout(std430, binding = 2) readonly buffer W { float w[]; };
layout(push_constant) uniform P { uint n; float eps; float scale; };

shared float part[256];

void main() {
    uint id = gl_LocalInvocationID.x, row = gl_WorkGroupID.x * n;
    float s = 0.0;
    for (uint i = id; i < n; i += 256) s += t[row + i] * t[row + i];
    part[id] = s;
    barrier();
    for (uint m = 128; m > 0; m >>= 1) {
        if (id < m) part[id] += part[id + m];
        barrier();
    }
    float inv = 1.0 / sqrt(part[0] / float(n) + eps);
    for (uint i = id; i < n; i += 256) x[row + i] = (x[row + i] + w[i] * (t[row + i] * inv)) * scale;
}
