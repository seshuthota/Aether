#version 450
// o[i] = a[i] for n4 vec4s, grid-stride. Memory bandwidth test (each byte
// is read once and written once).
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer In { vec4 a[]; };
layout(std430, binding = 1) writeonly buffer Out { vec4 o[]; };
layout(push_constant) uniform P { uint n4; };

void main() {
    uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < n4; i += stride) o[i] = a[i];
}
