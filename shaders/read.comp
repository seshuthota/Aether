#version 450
// Reads n4 vec4s (grid-stride, so neighbouring invocations read
// neighbouring 16-byte words; four loads in flight per invocation) and
// sums them. The sum is written only if it is -1, which the test data
// never gives: the compiler cannot drop the loads, and the test does not
// pay for writes. Memory bandwidth test. n4 must be a multiple of
// 4 * the stride.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer In { vec4 a[]; };
layout(std430, binding = 1) writeonly buffer Out { vec4 o[]; };
layout(push_constant) uniform P { uint n4; };

void main() {
    uint i = gl_GlobalInvocationID.x, stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    vec4 s0 = vec4(0.0), s1 = s0, s2 = s0, s3 = s0;
    for (; i < n4; i += 4 * stride) {
        s0 += a[i];
        s1 += a[i + stride];
        s2 += a[i + 2 * stride];
        s3 += a[i + 3 * stride];
    }
    vec4 s = (s0 + s1) + (s2 + s3);
    if (s.x == -1.0) o[gl_GlobalInvocationID.x] = s;
}
