#version 450
// o = gelu(a) · b, GELU's tanh form (`gelu_pytorch_tanh`, ggml's
// `ggml_gelu`), row by row: workgroup (g, t) does values 256g .. of token
// t, whose rows start `as`, `bs`, `os` floats after token t − 1's (Gemma
// 4's FFN: a = gate, b = up in the stacked gate/up rows; its per-layer
// block: a = the gate product, b = the token's per-layer input).
// 0.5 (1 + tanh(z)) = 1 / (1 + e^(−2z)), which stays finite where tanh's
// own e^(2z) would overflow.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) readonly buffer B { float b[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
layout(push_constant) uniform P { uint n; uint as_; uint bs; uint os; };

void main() {
    uint i = gl_GlobalInvocationID.x, t = gl_WorkGroupID.y;
    if (i >= n) return;
    float x = a[t * as_ + i];
    float z = 0.7978846 * x * (1.0 + 0.044715 * x * x);
    o[t * os + i] = x / (1.0 + exp(-2.0 * z)) * b[t * bs + i];
}
