#version 450
// out = W x for up to NT tokens, with x quantized to 8 bits (quant_x.comp)
// and the products in int8 dot products: OpSDot multiplies four int8
// pairs and adds them in one instruction (VK_KHR_shader_integer_dot_product).
// The work is split as in qx_gemv.comp's NT > 1 path (read that first): 4
// rows × the tokens per 32 lanes, lane l taking pieces l, l + 32, …; per
// piece, each token's 32 codes are loaded once for the 4 rows.
//
// qx_gemv.comp turns each weight into a float and multiplies it with an
// f32 x, for every token. Here the weight's bytes go into the dot product
// as they are: a nibble pair word masked to its low (or high) nibbles is
// four values 0–15 as bytes, the order of four x codes. The offsets the
// formats subtract (8 for Q4_0, 16 for Q5_0, 32 for Q6_K, Q4_K's min) are
// taken out once per piece with the codes' sums:
//
//   Σ (v − c) · q = Σ v · q − c · Σ q
//
// MatQ's layouts, scales and FMT ids are qx_gemv.comp's.
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_spirv_intrinsics : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer Q { uvec4 qs[]; };
layout(std430, binding = 1) readonly buffer S { uint sc[]; };
layout(std430, binding = 2) readonly buffer X { uvec4 xq[]; };
layout(std430, binding = 3) buffer O { float o[]; };
layout(push_constant) uniform P { uint rows; uint nb; uint tokens; uint ostride; };

layout(constant_id = 0) const bool ACCUM = false;
layout(constant_id = 1) const uint FMT = 2;
layout(constant_id = 2) const uint NT = 1;

// OpSDot (SPV_KHR_integer_dot_product, capabilities DotProduct and
// DotProductInput4x8BitPacked): the four signed bytes of a times those
// of b, summed. The literal 0 is PackedVectorFormat4x8Bit. The NDK's
// glslc predates GL_EXT_integer_dot_product, so the instruction is named
// by its opcode.
spirv_instruction(extensions = ["SPV_KHR_integer_dot_product"], capabilities = [6019, 6018], id = 4450)
int sdot(uint a, uint b, spirv_literal int fmt);
int dot4(uint a, uint b) { return sdot(a, b, 0); }

const uint M = 0x0f0f0f0fu;

uint ubyte(uint at, uint k) { return (sc[at + k / 4] >> (8 * (k % 4))) & 255u; }
int sbyte(uint at, uint k) { return bitfieldExtract(int(sc[at + k / 4]), int(8 * (k % 4)), 8); }
float half_d(uint i) { return unpackHalf2x16(sc[i / 2] >> (16 * (i & 1))).x; }
uint word(uint k) { return qs[k / 4][k % 4]; }
// Four bits (Q5_0's fifth bits of four values) as bit 4 of four bytes.
uint spread1(uint b) { return ((b * 0x00204081u) & 0x01010101u) << 4; }
// Four 2-bit fields (Q6_K's highs of four values) as bits 4–5 of four bytes.
uint spread2(uint f) { return ((f & 3u) | (f << 6 & 0x300u) | (f << 12 & 0x30000u) | (f << 18 & 0x3000000u)) << 4; }

// W's piece i times a token's piece (codes x0: values 0–15, x1: 16–31;
// xs: the sums of those codes), in units of the token's d.
float piece(uint i, uint n, uvec4 x0, uvec4 x1, ivec2 xs) {
    if (FMT == 8) {
        uvec4 a = qs[2 * i], b = qs[2 * i + 1];
        int s = dot4(a.x, x0.x) + dot4(a.y, x0.y) + dot4(a.z, x0.z) + dot4(a.w, x0.w)
              + dot4(b.x, x1.x) + dot4(b.y, x1.y) + dot4(b.z, x1.z) + dot4(b.w, x1.w);
        return half_d(i) * float(s);
    }
    uvec4 w = qs[i];
    uvec4 lo = w & M, hi = (w >> 4) & M;
    if (FMT == 6) {
        uint h = word(4 * n + i);
        lo |= uvec4(spread1(h & 15u), spread1(h >> 4 & 15u), spread1(h >> 8 & 15u), spread1(h >> 12 & 15u));
        hi |= uvec4(spread1(h >> 16 & 15u), spread1(h >> 20 & 15u), spread1(h >> 24 & 15u), spread1(h >> 28));
    }
    if (FMT == 14) {
        uint h0 = word(4 * n + 2 * i), h1 = word(4 * n + 2 * i + 1);
        lo |= uvec4(spread2(h0 & 255u), spread2(h0 >> 8 & 255u), spread2(h0 >> 16 & 255u), spread2(h0 >> 24));
        hi |= uvec4(spread2(h1 & 255u), spread2(h1 >> 8 & 255u), spread2(h1 >> 16 & 255u), spread2(h1 >> 24));
    }
    int s0 = dot4(lo.x, x0.x) + dot4(lo.y, x0.y) + dot4(lo.z, x0.z) + dot4(lo.w, x0.w);
    int s1 = dot4(hi.x, x1.x) + dot4(hi.y, x1.y) + dot4(hi.z, x1.z) + dot4(hi.w, x1.w);
    if (FMT == 2) return half_d(i) * float(s0 + s1 - 8 * (xs.x + xs.y));
    if (FMT == 6) return half_d(i) * float(s0 + s1 - 16 * (xs.x + xs.y));
    uint at = 5 * (i / 8), j = i % 8;
    vec2 dd = unpackHalf2x16(sc[at]);
    if (FMT == 12) return dd.x * float(ubyte(at + 1, j)) * float(s0 + s1) - dd.y * float(ubyte(at + 3, j)) * float(xs.x + xs.y);
    // FMT == 14
    return dd.x * (float(sbyte(at + 1, 2 * j)) * float(s0 - 32 * xs.x) + float(sbyte(at + 1, 2 * j + 1)) * float(s1 - 32 * xs.y));
}

void main() {
    uint lane = gl_LocalInvocationID.x & 31;
    uint wg = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint row0 = (wg * (gl_WorkGroupSize.x / 32) + gl_LocalInvocationID.x / 32) * 4;
    vec4 acc[NT];
    for (uint t = 0; t < NT; t++) acc[t] = vec4(0.0);
    uint nr = min(4, rows - min(rows, row0)), nt = min(tokens, NT);
    for (uint b = lane; b < nb; b += 32) {
        for (uint t = 0; t < NT; t++) {
            if (t < nt) {
                uint at = 3 * (t * nb + b);
                uvec4 x0 = xq[at], x1 = xq[at + 1], xm = xq[at + 2];
                float d = uintBitsToFloat(xm.x);
                ivec2 xs = ivec2(xm.yz);
                for (uint r = 0; r < 4; r++) {
                    if (r < nr) acc[t][r] += d * piece((row0 + r) * nb + b, rows * nb, x0, x1, xs);
                }
            }
        }
    }
    for (uint t = 0; t < NT; t++) {
        for (uint m = 16; m > 0; m >>= 1) acc[t] += subgroupShuffleXor(acc[t], m);
    }
    if (lane == 0) {
        uint stride = ostride == 0 ? rows : ostride;
        for (uint t = 0; t < NT; t++) {
            if (t >= nt) break;
            for (uint r = 0; r < 4; r++) {
                if (r < nr) {
                    uint i = t * stride + row0 + r;
                    o[i] = ACCUM ? o[i] + acc[t][r] : acc[t][r];
                }
            }
        }
    }
}
