#version 450
// Gemma 4's step after the q, k, v projections of one layer (the CPU
// path's order in `forward_traced`): per head, RMSNorm (q and k with their
// gain, v without one when `vnorm`), then RoPE on q and k for the first
// `pairs` pairs (element i with i + hs/2), then q × `qscale` (the attention
// scale folded into q, as on the CPU). q is written back in place; k and v
// go to the cache at the token's position when the layer owns its K/V
// (`own`), and are not read otherwise (layers that share a cache have no
// k, v in qkv).
//
// Workgroup (t, j): token t of the batch (position pos + t, its q, k, v
// `stride` floats after token t − 1's, its rotation table `rot_stride`
// pairs after token t − 1's, this layer's from pair `rot_off`); j < n_q is
// query head j, then the n_kv key heads, then the n_kv value heads. One
// head (up to 512 values) sits in shared memory.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Qkv { float qkv[]; };
layout(std430, binding = 1) readonly buffer Qn { float qn[]; };
layout(std430, binding = 2) readonly buffer Kn { float kn[]; };
layout(std430, binding = 3) writeonly buffer Kc { float kc[]; };
layout(std430, binding = 4) writeonly buffer Vc { float vc[]; };
layout(std430, binding = 5) readonly buffer Pm { uint pos; uint pad0; uint pad1; uint pad2; vec2 rot[]; };
layout(push_constant) uniform P {
    uint hs; uint n_q; uint n_kv; uint stride; uint layer_off; uint rot_off; uint rot_stride; uint pairs;
    uint own; uint vnorm; float qscale; float eps;
};

shared float head[512];
shared float red[256];

void main() {
    uint t = gl_WorkGroupID.x, j = gl_WorkGroupID.y, id = gl_LocalInvocationID.x;
    uint kv_dim = n_kv * hs, row = t * stride;
    // 0: q, 1: k, 2: v
    uint kind = j < n_q ? 0 : (j < n_q + n_kv ? 1 : 2);
    uint h = kind == 0 ? j : (kind == 1 ? j - n_q : j - n_q - n_kv);
    uint src = row + (kind == 0 ? h * hs : n_q * hs + (kind == 1 ? 0 : kv_dim) + h * hs);
    float s = 0.0;
    for (uint i = id; i < hs; i += 256) {
        float x = qkv[src + i];
        head[i] = x;
        s += x * x;
    }
    red[id] = s;
    barrier();
    for (uint m = 128; m > 0; m >>= 1) {
        if (id < m) red[id] += red[id + m];
        barrier();
    }
    bool norm = kind < 2 || vnorm != 0;
    float inv = 1.0 / sqrt(red[0] / float(hs) + eps);
    for (uint i = id; i < hs; i += 256) {
        float x = head[i];
        if (norm) x = kind == 0 ? qn[i] * (x * inv) : (kind == 1 ? kn[i] * (x * inv) : x * inv);
        head[i] = x;
    }
    barrier();
    uint half_hs = hs / 2;
    if (kind < 2) {
        for (uint i = id; i < pairs; i += 256) {
            vec2 sc = rot[t * rot_stride + rot_off + i];
            float a = head[i], c = head[i + half_hs];
            head[i] = a * sc.y - c * sc.x;
            head[i + half_hs] = a * sc.x + c * sc.y;
        }
        barrier();
    }
    if (kind == 0) {
        for (uint i = id; i < hs; i += 256) qkv[src + i] = head[i] * qscale;
    } else if (own != 0) {
        uint dst = layer_off + (pos + t) * kv_dim + h * hs;
        for (uint i = id; i < hs; i += 256) {
            if (kind == 1) kc[dst + i] = head[i]; else vc[dst + i] = head[i];
        }
    }
}
