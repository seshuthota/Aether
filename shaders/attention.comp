#version 450
// Attention of one token (decode) over positions 0..pos, one workgroup per
// query head h, reading K/V head h / (n_heads / n_kv) (grouped-query):
//   1. scores s_t = q·k_t / sqrt(hs), each thread every 256th position,
//      kept in `scores` (global scratch, one row of seq_len per head);
//   2. softmax: max and sum by shared-memory reductions;
//   3. out = Σ_t p_t v_t: 256 / hs groups of hs threads, group g summing
//      positions t ≡ g (mod 256 / hs), then the groups are added.
// hs must divide 256.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Qv { float q[]; };
layout(std430, binding = 1) readonly buffer Kc { float kc[]; };
layout(std430, binding = 2) readonly buffer Vc { float vc[]; };
layout(std430, binding = 3) buffer S { float scores[]; };
layout(std430, binding = 4) writeonly buffer O { float o[]; };
layout(std430, binding = 5) readonly buffer Pm { uint pos; };
layout(push_constant) uniform P { uint n_heads; uint n_kv; uint hs; uint seq_len; uint layer_off; };

shared float red[256];

float reduce_max(uint id, float v) {
    red[id] = v;
    barrier();
    for (uint m = 128; m > 0; m >>= 1) {
        if (id < m) red[id] = max(red[id], red[id + m]);
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

float reduce_sum(uint id, float v) {
    red[id] = v;
    barrier();
    for (uint m = 128; m > 0; m >>= 1) {
        if (id < m) red[id] += red[id + m];
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

void main() {
    uint h = gl_WorkGroupID.x, id = gl_LocalInvocationID.x;
    uint kv_dim = n_kv * hs, kvo = layer_off + (h / (n_heads / n_kv)) * hs, sb = h * seq_len;
    float scale = 1.0 / sqrt(float(hs));
    float mx = -1.0 / 0.0;
    for (uint t = id; t <= pos; t += 256) {
        float s = 0.0;
        for (uint d = 0; d < hs; d++) s += q[h * hs + d] * kc[kvo + t * kv_dim + d];
        s *= scale;
        scores[sb + t] = s;
        mx = max(mx, s);
    }
    float m = reduce_max(id, mx);
    float sum = 0.0;
    for (uint t = id; t <= pos; t += 256) {
        float e = exp(scores[sb + t] - m);
        scores[sb + t] = e;
        sum += e;
    }
    float total = reduce_sum(id, sum);
    memoryBarrierBuffer();
    barrier();
    uint groups = 256 / hs, g = id / hs, d = id % hs;
    float acc = 0.0;
    for (uint t = g; t <= pos; t += groups) acc += scores[sb + t] * vc[kvo + t * kv_dim + d];
    red[id] = acc;
    barrier();
    if (id < hs) {
        float a = 0.0;
        for (uint j = 0; j < groups; j++) a += red[j * hs + id];
        o[h * hs + id] = a / total;
    }
}
