#version 450
// x = cap · tanh(x / cap) (Gemma's final logit soft-cap), as
// sign(v) (1 − e) / (1 + e) with e = e^(−2|v|), finite for any x.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer X { float x[]; };
layout(push_constant) uniform P { uint n; float cap; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) return;
    float v = x[i] / cap, e = exp(-2.0 * abs(v));
    x[i] = cap * sign(v) * ((1.0 - e) / (1.0 + e));
}
