#version 450
#extension GL_EXT_spirv_intrinsics : require
// out[t][row] = W[row] · X[t] for a matrix W in any format of a llama.cpp
// Q4_K_M file (FMT, ggml's type id: Q4_0 2, Q5_0 6, Q8_0 8, Q4_K 12, Q6_K
// 14) and `tokens` activations quantized to 8 bits (quant_x.comp with
// PAIRS), in int8 dot products: q4_0_gemm_q8.comp (read that first) for every
// format, in qx_gemm_h.comp's layout (`MatQT::new_paired`: that one's words,
// except that the high bits and Q8_0's bytes are in the order of x's pairs).
//
// A piece's weights as bytes in the order of x's code words:
//   nibble formats  lo = word & 0x0f0f0f0f (values 8h + 0, 2, 4, 6) and
//                   hi = (word >> 4) & 0x0f0f0f0f (8h + 1, 3, 5, 7)
//   Q5_0   word 4 holds, in nibble 2h, the fifth bits of values 8h, 8h + 2,
//          8h + 4, 8h + 6 (bit i: value 8h + 2i), in nibble 2h + 1 the odd ones
//   Q6_K   words 4 and 5 are 8 bytes, byte 2h the two high bits of the even
//          values of group h (value 8h + 2i in bits 2i), byte 2h + 1 the odd
//   Q8_0   word 2h the even values of group h as bytes, word 2h + 1 the odd
// and with Σ the sum of a token's codes (halves Σ0, Σ1 for values 0–15 and
// 16–31), s the integer dot product, a and c the piece's two scales:
//   Q4_0   a · (s − 8 Σ)          Q5_0   a · (s − 16 Σ)         Q8_0   a · s
//   Q4_K   a · s − c · Σ          Q6_K   a · (s0 − 32 Σ0) + c · (s1 − 32 Σ1)
// all times the token's d. `ostride` is the length of a token's row of `o`
// (0: rows). Workgroup (i, j): rows 256i .. 256i + 255, tokens 8j .. 8j + 7.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Q { uvec4 q[]; };
layout(std430, binding = 1) readonly buffer S { uvec2 s[]; };
layout(std430, binding = 2) readonly buffer X { uvec4 xq[]; };
layout(std430, binding = 3) buffer O { float o[]; };
layout(push_constant) uniform P { uint rows; uint nb; uint tokens; uint npad; uint ostride; };
layout(constant_id = 0) const bool ACCUM = false;
layout(constant_id = 1) const uint FMT = 2;

spirv_instruction(extensions = ["SPV_KHR_integer_dot_product"], capabilities = [6019, 6018], id = 4450)
int sdot(uint a, uint b, spirv_literal int fmt);
int dot4(uint a, uint b) { return sdot(a, b, 0); }

const uint M = 0x0f0f0f0fu;
const uint NW = FMT == 8 ? 8 : FMT == 6 ? 5 : FMT == 14 ? 6 : 4;
const uint NS = FMT >= 12 ? 2 : 1;

// Four bits (a nibble) as bit 4 of four bytes.
uint spread1(uint b) { return ((b * 0x00204081u) & 0x01010101u) << 4; }
// Four 2-bit fields (a byte) as bits 4–5 of four bytes.
uint spread2(uint f) { return ((f & 3u) | (f << 6 & 0x300u) | (f << 12 & 0x30000u) | (f << 18 & 0x3000000u)) << 4; }

// The workgroup's 8 tokens' x for BC pieces at a time (q4_0_gemm_q8.comp).
const uint BC = 8;
shared uvec4 sx[BC * 8 * 3];

void main() {
    uint quad = gl_GlobalInvocationID.x, rq = (rows + 3) / 4;
    bool live = quad < rq;
    uint t0 = gl_WorkGroupID.y * 8;
    vec4 acc[8];
    for (uint t = 0; t < 8; t++) acc[t] = vec4(0.0);
    for (uint b0 = 0; b0 < nb; b0 += BC) {
        uint nc = min(BC, nb - b0);
        barrier();
        for (uint i = gl_LocalInvocationID.x; i < nc * 24; i += 64) {
            uint p = i / 3, t = p / nc, bb = p % nc;
            sx[(bb * 8 + t) * 3 + i % 3] = xq[3 * ((t0 + t) * nb + b0 + bb) + i % 3];
        }
        barrier();
        if (!live) continue;
        for (uint bb = 0; bb < nc; bb++) {
            uint b = b0 + bb;
            uvec2 sa = s[NS * b * rq + quad];
            vec4 a = vec4(unpackHalf2x16(sa.x), unpackHalf2x16(sa.y));
            vec4 c = a;
            if (NS == 2) {
                uvec2 sc = s[(NS * b + 1) * rq + quad];
                c = vec4(unpackHalf2x16(sc.x), unpackHalf2x16(sc.y));
            }
            uint at = NW * b * rq + quad;
            // The weights as bytes, per group h of 8 values: lo / hi (or for
            // Q8_0, w[2h] / w[2h + 1]), each across the 4 rows.
            uvec4 lo[4], hi[4];
            for (uint h = 0; h < 4; h++) {
                if (FMT == 8) {
                    lo[h] = q[at + 2 * h * rq];
                    hi[h] = q[at + (2 * h + 1) * rq];
                } else {
                    uvec4 w = q[at + h * rq];
                    lo[h] = w & M;
                    hi[h] = (w >> 4) & M;
                }
            }
            if (FMT == 6) {
                uvec4 h5 = q[at + 4 * rq];
                for (uint h = 0; h < 4; h++) {
                    for (uint r = 0; r < 4; r++) {
                        lo[h][r] |= spread1((h5[r] >> (8 * h)) & 15u);
                        hi[h][r] |= spread1((h5[r] >> (8 * h + 4)) & 15u);
                    }
                }
            }
            if (FMT == 14) {
                uvec4 h0 = q[at + 4 * rq], h1 = q[at + 5 * rq];
                for (uint h = 0; h < 4; h++) {
                    for (uint r = 0; r < 4; r++) {
                        uint f = h < 2 ? h0[r] : h1[r];
                        lo[h][r] |= spread2((f >> (16 * (h % 2))) & 255u);
                        hi[h][r] |= spread2((f >> (16 * (h % 2) + 8)) & 255u);
                    }
                }
            }
            for (uint t = 0; t < 8; t++) {
                uint xat = (bb * 8 + t) * 3;
                uvec4 xa = sx[xat], xb = sx[xat + 1], xm = sx[xat + 2];
                int sum0 = int(xm.y), sum1 = int(xm.z);
                float dx = uintBitsToFloat(xm.x);
                for (uint r = 0; r < 4; r++) {
                    int s0 = dot4(lo[0][r], xa.x) + dot4(hi[0][r], xa.y) + dot4(lo[1][r], xa.z) + dot4(hi[1][r], xa.w);
                    int s1 = dot4(lo[2][r], xb.x) + dot4(hi[2][r], xb.y) + dot4(lo[3][r], xb.z) + dot4(hi[3][r], xb.w);
                    float v;
                    if (FMT == 2) v = a[r] * float(s0 + s1 - 8 * (sum0 + sum1));
                    else if (FMT == 6) v = a[r] * float(s0 + s1 - 16 * (sum0 + sum1));
                    else if (FMT == 8) v = a[r] * float(s0 + s1);
                    else if (FMT == 12) v = a[r] * float(s0 + s1) - c[r] * float(sum0 + sum1);
                    else v = a[r] * float(s0 - 32 * sum0) + c[r] * float(s1 - 32 * sum1);
                    acc[t][r] += dx * v;
                }
            }
        }
    }
    if (!live) return;
    uint stride = ostride == 0 ? rows : ostride;
    for (uint t = 0; t < 8; t++) {
        uint tok = t0 + t;
        if (tok >= tokens) break;
        for (uint r = 0; r < 4; r++) {
            uint row = 4 * quad + r;
            if (row < rows) {
                uint i = tok * stride + row;
                o[i] = ACCUM ? o[i] + acc[t][r] : acc[t][r];
            }
        }
    }
}
