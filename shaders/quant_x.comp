#version 450
// x to 8 bits per 32 values, for the int8 products (qx_gemv_q8.comp): as
// llama.cpp's Q8_0 (d = max |x| / 127, q = x / d rounded half away from
// zero, as gguf-py's np_roundf), except that d stays f32. One thread per
// 32-value piece of one token.
//
// Piece b of token t is 3 uvec4s at 3 · (t · nb + b): the 32 int8s (values
// 4k .. 4k + 3 in word k, low byte first), then d's bits and the sums of
// the codes of values 0–15 and 16–31 (the products subtract the weights'
// offsets with them). With GLU, x is gate then up per token, and the
// values are silu(gate) · up, as qx_gemv.comp's xtok.
//
// With PAIRS, the 32 int8s are stored for q4_0_gemm_q8.comp: per group of 8
// values 8g .. 8g + 7, one word of values 8g, 8g + 2, 8g + 4, 8g + 6 and
// one of 8g + 1, 8g + 3, 8g + 5, 8g + 7 (the order of a nibble word's
// masked low and high nibbles).
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer X { vec4 x[]; };
layout(std430, binding = 1) writeonly buffer Q { uvec4 xq[]; };
layout(push_constant) uniform P { uint nb; uint tokens; };

layout(constant_id = 0) const bool GLU = false;
layout(constant_id = 1) const bool PAIRS = false;

vec4 xtok(uint t, uint i) {
    if (!GLU) return x[t * 8 * nb + i];
    vec4 g = x[t * 16 * nb + i];
    return g / (1.0 + exp(-g)) * x[t * 16 * nb + 8 * nb + i];
}

// gguf-py's np_roundf: half away from zero.
ivec4 roundf(vec4 v) {
    vec4 a = abs(v), f = floor(a);
    return ivec4(sign(v) * (f + floor(2.0 * (a - f))));
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= nb * tokens) return;
    uint t = id / nb, b = id % nb;
    vec4 v[8];
    vec4 m = vec4(0.0);
    for (uint k = 0; k < 8; k++) {
        v[k] = xtok(t, 8 * b + k);
        m = max(m, abs(v[k]));
    }
    float d = max(max(m.x, m.y), max(m.z, m.w)) / 127.0;
    float inv = d == 0.0 ? 0.0 : 1.0 / d;
    uint w[8];
    int s[2] = int[2](0, 0);
    ivec4 qv[8];
    for (uint k = 0; k < 8; k++) {
        qv[k] = roundf(v[k] * inv);
        s[k / 4] += qv[k].x + qv[k].y + qv[k].z + qv[k].w;
    }
    for (uint k = 0; k < 8; k++) {
        ivec4 q = qv[k];
        if (PAIRS) {
            ivec4 a = qv[k & ~1u], b = qv[k | 1u];
            q = (k & 1u) == 0 ? ivec4(a.x, a.z, b.x, b.z) : ivec4(a.y, a.w, b.y, b.w);
        }
        uvec4 u = uvec4(q) & 255u;
        w[k] = u.x | u.y << 8 | u.z << 16 | u.w << 24;
    }
    xq[3 * id] = uvec4(w[0], w[1], w[2], w[3]);
    xq[3 * id + 1] = uvec4(w[4], w[5], w[6], w[7]);
    xq[3 * id + 2] = uvec4(floatBitsToUint(d), uint(s[0]), uint(s[1]), 0);
}
