#version 450
// g = silu(g) · u, silu(g) = g / (1 + e^(−g)).
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer G { float g[]; };
layout(std430, binding = 1) readonly buffer U { float u[]; };
layout(push_constant) uniform P { uint n; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < n) g[i] = g[i] / (1.0 + exp(-g[i])) * u[i];
}
