#version 450
// attention_tile.comp over the whole context: workgroup (h, g) takes query
// head h and the 32 tokens 32g .. 32g + 31 of the batch, walks every
// position they can see in one pass and writes the finished output to xb2.
// Flash attention (Dao et al. 2022): one running (max m, sum l, weighted
// sum acc) per token, rescaled as new positions arrive, divided by l once
// at the end.
//
// The two-dispatches-a-layer split of attention_tile.comp is right for
// decode (one token has only n_heads workgroups' worth of work), but a
// prompt has plenty of parallel work in its tokens, and the split costs
// the partial results (hs + 2 floats per token, head and chunk: ~30 MB a
// layer at 128 tokens and depth 4096, written and read), a second dispatch
// and barrier per layer, and a `parts` buffer whose size shrinks the batch
// as the context grows (17 tokens at seq_len 32768, so the 64-token GEMM
// tiles run a quarter full). This shader has no `parts` and no merge; its
// batch is 128 whatever the context.
//
// Same thread layout and online softmax as attention_tile.comp: four
// threads share two tokens (t and t + 16), each holding 16 of both
// queries' 64 values and 16 of both outputs' in registers; the keys and
// values go through shared memory SUB positions at a time, as f16 (half
// the bytes per read, as llama.cpp's default cache holds them), read by
// every thread at once and serving both tokens. A score is four partial
// dot products added with two subgroup shuffles. Only the causal mask
// differs between tokens, so the workgroup's last position bounds the
// loop for all of them.
// hs must be at most 64 (four threads × 16 values).
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_EXT_control_flow_attributes : enable
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Qv { float q[]; };
layout(std430, binding = 1) readonly buffer Kc { float kc[]; };
layout(std430, binding = 2) readonly buffer Vc { float vc[]; };
layout(std430, binding = 3) writeonly buffer O { float o[]; };
layout(std430, binding = 4) readonly buffer Pm { uint pos; };
layout(push_constant) uniform P { uint n_heads; uint n_kv; uint hs; uint layer_off; uint qstride; uint ntok; };

// U tokens per thread (t, t + 16, ...).
const uint U = 2, TQ = 16 * U, SUB = 16;
// Keys and values of SUB positions, 16 vec4s (64 values) per position.
// Stored as f16 pairs (packHalf2x16), half the bytes per read.
shared uvec2 ks[SUB * 16];
shared uvec2 vs[SUB * 16];

uvec2 pack4(vec4 v) { return uvec2(packHalf2x16(v.xy), packHalf2x16(v.zw)); }
vec4 unpack4(uvec2 p) { return vec4(unpackHalf2x16(p.x), unpackHalf2x16(p.y)); }

void main() {
    uint h = gl_WorkGroupID.x, id = gl_LocalInvocationID.x;
    uint tok0 = gl_WorkGroupID.y * TQ, nq = min(TQ, ntok - tok0);
    // Thread (t, part): values 16·part .. 16·part + 15 of tokens t, t + 16.
    uint t = id / 4, part = id % 4;
    uint at[U];
    bool live[U];
    [[unroll]] for (uint u = 0; u < U; u++) {
        at[u] = pos + tok0 + t + 16 * u;
        live[u] = t + 16 * u < nq;
    }
    uint kv_dim = n_kv * hs, kvo = layer_off + (h / (n_heads / n_kv)) * hs;
    vec4 qv[U][4], acc[U][4];
    [[unroll]] for (uint u = 0; u < U; u++) {
        [[unroll]] for (uint i = 0; i < 4; i++) {
            // Values past a head whose size is not a multiple of four (the
            // test's 17; the models' 64 and 48 are whole vec4s) stay zero:
            // they are the next head's, and the last head's would be past
            // the buffer, so each lane loads only if it is inside the head.
            uint d = 16 * part + 4 * i;
            uint qo = (tok0 + t + 16 * u) * qstride + h * hs + d;
            vec4 v = vec4(0.0);
            if (live[u]) {
                if (d + 0 < hs) v.x = q[qo + 0];
                if (d + 1 < hs) v.y = q[qo + 1];
                if (d + 2 < hs) v.z = q[qo + 2];
                if (d + 3 < hs) v.w = q[qo + 3];
            }
            qv[u][i] = v;
            acc[u][i] = vec4(0.0);
        }
    }
    float m[U], l[U];
    [[unroll]] for (uint u = 0; u < U; u++) {
        m[u] = -1.0 / 0.0;
        l[u] = 0.0;
    }
    float scale = 1.0 / sqrt(float(hs));
    // The last position any token of the workgroup reaches: the mask below
    // is per token, and every thread runs the same iterations (the
    // barriers need that). Every token sees position 0, so the first
    // sub-tile always leaves m finite: exp(-inf - m') = 0 is the rescale
    // of an empty sum.
    uint last = pos + tok0 + nq - 1;
    for (uint j0 = 0; j0 <= last; j0 += SUB) {
        uint n = min(SUB, last + 1 - j0);
        // 64 threads load SUB × 16 vec4s of keys and of values.
        for (uint k = id; k < SUB * 16; k += 64) {
            uint j = k / 16, d = 4 * (k % 16), at_k = kvo + (j0 + j) * kv_dim + d;
            vec4 kv = vec4(0.0), vv = vec4(0.0);
            if (j < n) {
                if (d + 0 < hs) { kv.x = kc[at_k + 0]; vv.x = vc[at_k + 0]; }
                if (d + 1 < hs) { kv.y = kc[at_k + 1]; vv.y = vc[at_k + 1]; }
                if (d + 2 < hs) { kv.z = kc[at_k + 2]; vv.z = vc[at_k + 2]; }
                if (d + 3 < hs) { kv.w = kc[at_k + 3]; vv.w = vc[at_k + 3]; }
            }
            ks[k] = pack4(kv);
            vs[k] = pack4(vv);
        }
        barrier();
        for (uint j = 0; j < n; j++) {
            uint b = j * 16 + 4 * part, tj = j0 + j;
            vec4 k0 = unpack4(ks[b]), k1 = unpack4(ks[b + 1]), k2 = unpack4(ks[b + 2]), k3 = unpack4(ks[b + 3]);
            vec4 v0 = unpack4(vs[b]), v1 = unpack4(vs[b + 1]), v2 = unpack4(vs[b + 2]), v3 = unpack4(vs[b + 3]);
            [[unroll]] for (uint u = 0; u < U; u++) {
                float p = dot(qv[u][0], k0) + dot(qv[u][1], k1) + dot(qv[u][2], k2) + dot(qv[u][3], k3);
                p += subgroupShuffleXor(p, 1);
                p += subgroupShuffleXor(p, 2);
                if (live[u] && tj <= at[u]) {
                    float s = p * scale, m2 = max(m[u], s), r = exp(m[u] - m2), e = exp(s - m2);
                    l[u] = l[u] * r + e;
                    acc[u][0] = acc[u][0] * r + e * v0;
                    acc[u][1] = acc[u][1] * r + e * v1;
                    acc[u][2] = acc[u][2] * r + e * v2;
                    acc[u][3] = acc[u][3] * r + e * v3;
                    m[u] = m2;
                }
            }
        }
        barrier();
    }
    // The layout attention_merge.comp writes into xb2.
    [[unroll]] for (uint u = 0; u < U; u++) {
        if (!live[u]) continue;
        uint base = ((tok0 + t + 16 * u) * n_heads + h) * hs;
        [[unroll]] for (uint i = 0; i < 4; i++) {
            uint d = 16 * part + 4 * i;
            vec4 v = acc[u][i] / l[u];
            if (d + 0 < hs) o[base + d + 0] = v.x;
            if (d + 1 < hs) o[base + d + 1] = v.y;
            if (d + 2 < hs) o[base + d + 2] = v.z;
            if (d + 3 < hs) o[base + d + 3] = v.w;
        }
    }
}
