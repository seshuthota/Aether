#version 450
// Attention part 2 of 2 for decode, and for the chunked prompt option
// (`Options::attn_chunked`; flash attention needs no merge): for query
// head h (workgroup h), combines the chunks of attention.comp: with M the
// largest chunk max,
//   out[d] = Σ_c e^(m_c − M) out_c[d] / Σ_c e^(m_c − M) l_c.
// Workgroup (h, t) does token t of a batch, at position pos + t. Thread d
// writes elements d, d + 64, ... With `window` > 0 the chunks wholly
// before the window (which attention.comp left unwritten) are skipped.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Pt { float parts[]; };
layout(std430, binding = 1) writeonly buffer O { float o[]; };
layout(std430, binding = 2) readonly buffer Pm { uint pos; };
layout(push_constant) uniform P { uint hs; uint chunks; uint window; };

void main() {
    uint h = gl_WorkGroupID.x, t = gl_WorkGroupID.y;
    uint n_heads = gl_NumWorkGroups.x;
    uint at = pos + t, n = at / 64 + 1, stride = hs + 2, base = (t * n_heads + h) * chunks * stride;
    uint c0 = window > 0 && at + 1 > window ? (at + 1 - window) / 64 : 0;
    for (uint d = gl_LocalInvocationID.x; d < hs; d += 64) {
        float mx = -1.0 / 0.0;
        for (uint c = c0; c < n; c++) mx = max(mx, parts[base + c * stride]);
        float num = 0.0, den = 0.0;
        for (uint c = c0; c < n; c++) {
            float w = exp(parts[base + c * stride] - mx);
            num += w * parts[base + c * stride + 2 + d];
            den += w * parts[base + c * stride + 1];
        }
        o[(t * n_heads + h) * hs + d] = num / den;
    }
}
