+// ---- aether: activation dumps (tools/llama2c-dump.patch) -------------------
+// When AETHER_DUMP names a file, every dump() call appends one record:
+// u32 name_len, name bytes, i32 layer (-1 = not in a layer), i32 pos,
+// u32 n, n x f32. All little-endian.
+static FILE* aether_dump = NULL;
+static void dump(const char* name, int layer, int pos, const float* data, int n) {
+    if (!aether_dump) { return; }
+    unsigned int len = (unsigned int)strlen(name), un = (unsigned int)n;
+    fwrite(&len, 4, 1, aether_dump); fwrite(name, 1, len, aether_dump);
+    fwrite(&layer, 4, 1, aether_dump); fwrite(&pos, 4, 1, aether_dump);
+    fwrite(&un, 4, 1, aether_dump); fwrite(data, 4, n, aether_dump);
+}
